DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# Per-server roles and channels. Add one entry for each Discord server ID.
GUILD_SETTINGS='{"<guild-id>":{"autoRoleId":"<role-id>","supportRoleId":"<role-id>","applicationReviewChannelId":"<channel-id>","approvedRoleId":"<role-id>"}}'

# Optional single-server fallbacks (used when the guild has no matching GUILD_SETTINGS entry)
AUTO_ROLE_ID=
SUPPORT_ROLE_ID=
APPLICATION_REVIEW_CHANNEL_ID=
APPROVED_ROLE_ID=

# Alert when this many members join within the configured window
RAID_JOIN_THRESHOLD=5
RAID_WINDOW_MS=10000
